# Copy to .env and fill in what you have. Never commit .env.
# Keys can instead be saved from Settings -> API credentials (stored in your OS credential store).

# Auto.dev listings API. Check your account's plan and limits: https://auto.dev/pricing
AUTODEV_API_KEY=

# MarketCheck inventory API. Check plan/radius limits: https://www.marketcheck.com/apis/pricing
MARKETCHECK_API_KEY=
# MARKETCHECK_BASE_URL=https://api.marketcheck.com

# Optional overrides. Existing RIVIAN_FINDER_* names remain supported for compatibility.
# RIVIAN_FINDER_DATA_DIR=C:\path\to\data        # where the database, backups, exports and logs live
# RIVIAN_FINDER_PORT=8501                       # web UI port (127.0.0.1 only)
# RIVIAN_FINDER_CAPTURE_PORT=8765               # browser-extension receiver (also edit extension/manifest.json + popup.js)
